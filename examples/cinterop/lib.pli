/* PL/I routines for C programs */
ADD3: PROCEDURE(A, B, TAG) OPTIONS(C) RETURNS(FIXED BINARY(31))
      EXTERNAL('add3');
  DECLARE (A, B) FIXED BINARY(31);
  DECLARE TAG CHAR(*);
  PUT SKIP LIST('add3 called with', TAG, LENGTH(TAG));
  RETURN(A + B);
END ADD3;

HYPOT2: PROCEDURE(X, Y) OPTIONS(C) RETURNS(FLOAT BINARY(53))
        EXTERNAL('hypot2');
  DECLARE (X, Y) FLOAT BINARY(53);
  RETURN(SQRT(X * X + Y * Y));
END HYPOT2;

FILLSQ: PROCEDURE(V, N) OPTIONS(C) EXTERNAL('fillsq');
  DECLARE V(8) FLOAT BINARY(53);
  DECLARE N FIXED BINARY(31);
  DECLARE I FIXED BINARY(31);
  DO I = 1 TO N;
    V(I) = I * I;
  END;
END FILLSQ;
