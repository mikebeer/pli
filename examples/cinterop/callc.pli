CI: PROCEDURE OPTIONS(MAIN);
  DECLARE SQRT_C ENTRY(FLOAT BINARY(53)) RETURNS(FLOAT BINARY(53))
      OPTIONS(C) EXTERNAL('sqrt');
  DECLARE STRLEN ENTRY(CHAR(*)) RETURNS(FIXED BINARY(31)) OPTIONS(C);
  DECLARE ABS_C ENTRY(FIXED BINARY(31)) RETURNS(FIXED BINARY(31))
      OPTIONS(C) EXTERNAL('abs');
  DECLARE PUTS ENTRY(CHAR(*)) RETURNS(FIXED BINARY(31)) OPTIONS(C);
  DECLARE ATOI ENTRY(CHAR(*)) RETURNS(FIXED BINARY(31)) OPTIONS(C);
  DECLARE R FIXED BINARY(31);
  DECLARE X FLOAT BINARY(53);
  X = SQRT_C(2);
  PUT SKIP LIST('sqrt(2) =', X);
  PUT SKIP LIST('strlen =', STRLEN('hello, world'));
  PUT SKIP LIST('abs =', ABS_C(-42));
  PUT SKIP LIST('atoi =', ATOI('1234') + 1);
END CI;
