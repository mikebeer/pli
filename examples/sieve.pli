/* sieve.pli -- primes below 100 with the sieve of Eratosthenes */
SIEVE: PROCEDURE OPTIONS(MAIN);
  DECLARE PRIME(100) BIT(1);
  DECLARE (I, J, COUNT) FIXED BINARY(31);
  PRIME = '1'B;
  PRIME(1) = '0'B;
  DO I = 2 TO 10;
    IF PRIME(I) THEN
      DO J = I * I TO 100 BY I;
        PRIME(J) = '0'B;
      END;
  END;
  COUNT = 0;
  DO I = 1 TO 100;
    IF PRIME(I) THEN DO;
      COUNT = COUNT + 1;
      PUT EDIT(I) (F(4));
      IF MOD(COUNT, 10) = 0 THEN PUT SKIP;
    END;
  END;
  PUT SKIP LIST('primes found:', COUNT);
END SIEVE;
