/* main program */
MAIN: PROCEDURE OPTIONS(MAIN);
  DECLARE SQUARE ENTRY(FIXED BINARY(31)) RETURNS(FIXED BINARY(31));
  DECLARE SHOW ENTRY(CHAR(*));
  DECLARE COUNTER FIXED BINARY(31) EXTERNAL INITIAL(0);
  DECLARE I FIXED BINARY(31);
  DO I = 1 TO 3;
    CALL SHOW('square of ' || I);
    PUT SKIP LIST(SQUARE(I));
  END;
  PUT SKIP LIST('calls', COUNTER);
END MAIN;
