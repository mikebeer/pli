/* Keyed record file: add, read, rewrite, delete, list by key */
KEYED: PROCEDURE OPTIONS(MAIN);
  DECLARE EMP FILE RECORD KEYED UPDATE;
  DECLARE REC CHARACTER(20);

  LISTALL: PROCEDURE(F);
    DECLARE F FILE;
    DECLARE R CHARACTER(20), KY CHARACTER(5);
    ON ENDFILE(F) GOTO DONE;
    DO WHILE ('1'B);
      READ FILE(F) INTO(R) KEYTO(KY);
      PUT SKIP LIST(KY, R);
    END;
  DONE: ;
  END LISTALL;

  OPEN FILE(EMP) TITLE('emp.dat') OUTPUT KEYED;
  WRITE FILE(EMP) FROM('Smith, J') KEYFROM('E0300');
  WRITE FILE(EMP) FROM('Adams, B') KEYFROM('E0100');
  WRITE FILE(EMP) FROM('Jones, K') KEYFROM('E0200');
  ON KEY(EMP) BEGIN;
    PUT SKIP LIST('KEY condition, ONCODE', ONCODE);
  END;
  WRITE FILE(EMP) FROM('Duplicate') KEYFROM('E0100');
  CLOSE FILE(EMP);

  OPEN FILE(EMP) TITLE('emp.dat') UPDATE KEYED;
  READ FILE(EMP) INTO(REC) KEY('E0200');
  PUT SKIP LIST('E0200 is', REC);
  REWRITE FILE(EMP) FROM('Jones, Karen');
  DELETE FILE(EMP) KEY('E0300');
  READ FILE(EMP) INTO(REC) KEY('E9999');
  CLOSE FILE(EMP);

  OPEN FILE(EMP) TITLE('emp.dat') INPUT KEYED;
  CALL LISTALL(EMP);
  CLOSE FILE(EMP);
END KEYED;
