T26: PROCEDURE OPTIONS(MAIN);
  DECLARE X FIXED DECIMAL(5,1);
  DECLARE F FILE RECORD, R CHAR(10), N FIXED BINARY(31);

  ONE: PROCEDURE;
    ON ZERODIVIDE BEGIN; PUT SKIP LIST('inner handler'); END;
    X = 1 / 0;
    CALL TWO;
  END ONE;

  TWO: PROCEDURE;
    X = 2 / 0;
  END TWO;

  FN: PROCEDURE(A) RETURNS(FIXED BINARY(31));
    DECLARE A FIXED BINARY(31);
    ON CONVERSION BEGIN; PUT SKIP LIST('fn handler'); END;
    RETURN(A + 1);
  END FN;

  COUNT: PROCEDURE RETURNS(FIXED BINARY(31));
    DECLARE C FIXED BINARY(31) INITIAL(0);
    ON ENDFILE(F) GOTO DONE;
    DO WHILE ('1'B);
      READ FILE(F) INTO(R);
      C = C + 1;
    END;
  DONE:
    RETURN(C);
  END COUNT;

  ON ZERODIVIDE BEGIN; PUT SKIP LIST('outer handler'); END;
  CALL ONE;
  X = 3 / 0;
  PUT SKIP LIST(FN(4));
  OPEN FILE(F) TITLE('c.txt') OUTPUT;
  WRITE FILE(F) FROM('a');
  WRITE FILE(F) FROM('b');
  CLOSE FILE(F);
  OPEN FILE(F) TITLE('c.txt') INPUT;
  N = COUNT();
  PUT SKIP LIST('records', N);
  CLOSE FILE(F);
  PUT SKIP LIST('end');
END T26;
