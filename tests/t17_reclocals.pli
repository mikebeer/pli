/* recursive procedures with local variables and strings */
RL: PROCEDURE OPTIONS(MAIN);
  DECLARE (I, N) FIXED BINARY(31);

  DEPTH: PROCEDURE(N, PREFIX) RECURSIVE;
    DECLARE N FIXED BINARY(31);
    DECLARE PREFIX CHAR(*);
    DECLARE LOCAL FIXED BINARY(31);
    DECLARE TEXT CHAR(20) VARYING;
    LOCAL = N * 10;
    TEXT = PREFIX || N;
    IF N > 0 THEN CALL DEPTH(N - 1, TEXT || '.');
    PUT SKIP LIST(TEXT, LOCAL);
  END DEPTH;

  GCD: PROCEDURE(A, B) RETURNS(FIXED BINARY(31)) RECURSIVE;
    DECLARE (A, B) FIXED BINARY(31);
    IF B = 0 THEN RETURN(A);
    RETURN(GCD(B, MOD(A, B)));
  END GCD;

  ACK: PROCEDURE(M, N) RETURNS(FIXED BINARY(31)) RECURSIVE;
    DECLARE (M, N) FIXED BINARY(31);
    IF M = 0 THEN RETURN(N + 1);
    IF N = 0 THEN RETURN(ACK(M - 1, 1));
    RETURN(ACK(M - 1, ACK(M, N - 1)));
  END ACK;

  CALL DEPTH(2, 'n');
  PUT SKIP LIST('gcd(1071, 462) =', GCD(1071, 462));
  PUT SKIP LIST('ack(2, 3) =', ACK(2, 3));
END RL;
