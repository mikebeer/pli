/* PUT STRING and GET STRING */
SIO: PROCEDURE OPTIONS(MAIN);
  DECLARE S CHAR(30);
  DECLARE (A, B) FIXED BINARY(31);
  DECLARE X FIXED DECIMAL(7, 2);
  PUT STRING(S) EDIT(17, 'abc', 3.5) (F(4), A(5), F(6, 2));
  PUT SKIP LIST('[' || S || ']');
  GET STRING('  12   34') LIST(A, B);
  PUT SKIP LIST(A, B, A * B);
  GET STRING('  250') EDIT(X) (F(5, 2));
  PUT SKIP LIST(X);
  PUT STRING(S) LIST('a', 'b');
  PUT SKIP LIST(S);
END SIO;
