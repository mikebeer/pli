/* more preprocessor: recursion, include, rescan, selection */
pp2: procedure options(main);
%include t34_pp2;
%dcl (f, v, w) fixed;
%dcl s char;
%fact: proc (n) returns (fixed);
   %dcl r fixed;
   %if n <= 1 %then %return (1);
   %r = n * fact(n - 1);
   %return (r);
%end fact;
%v = fact(5);
%s = 'v + 1';
%activate v, s;
%dcl mode char;
%mode = 'fast';
%activate mode;
dcl x fixed bin(31) init(s);
%deactivate v;
put skip list ('x', x);
put skip list ('mode', 'mode');
%if mode = 'fast' %then %do;
  put skip list ('fast branch');
%end;
%dcl j fixed;
%activate j;
%do j = 10 to 1 by -4;
  put skip list ('j', j);
%end;
%if inc_seen = 7 & mod(17, 5) = 2 %then put skip list ('mod ok');
%if max(3, 9, 4) = 9 & min(3, 9) = 3 %then put skip list ('minmax');
%if uppercase('ab') = 'AB' %then put skip list ('upper');
%note('done', 0);
end pp2;
