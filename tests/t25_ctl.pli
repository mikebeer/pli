T25: PROCEDURE OPTIONS(MAIN);
  DECLARE T(*) FIXED BINARY(31) CONTROLLED;
  DECLARE S FIXED BINARY(31) CONTROLLED;
  DECLARE (I, N) FIXED BINARY(31);
  N = 5;
  ALLOCATE T(N);
  DO I = 1 TO N; T(I) = I * I; END;
  PUT SKIP LIST(LBOUND(T,1), HBOUND(T,1), T(5));
  ALLOCATE T(0:2);
  T(0) = 100; T(1) = 200; T(2) = 300;
  PUT SKIP LIST(LBOUND(T,1), HBOUND(T,1), T(2), ALLOCATION(T));
  FREE T;
  PUT SKIP LIST(LBOUND(T,1), HBOUND(T,1), T(3), ALLOCATION(T));
  FREE T;
  PUT SKIP LIST(ALLOCATION(T));
  ALLOCATE S; S = 1; ALLOCATE S; S = 2;
  PUT SKIP LIST(S, ALLOCATION(S));
  FREE S;
  PUT SKIP LIST(S);
END T25;
