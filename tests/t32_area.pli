T32: PROCEDURE OPTIONS(MAIN);
  DECLARE AR AREA(200);
  DECLARE (P, Q) POINTER, O OFFSET(AR);
  DECLARE 1 REC BASED(P), 2 N FIXED BINARY(31), 2 NAME CHAR(10);
  DECLARE 1 NODE BASED(Q), 2 V FIXED BINARY(31), 2 NEXT POINTER;
  DECLARE I FIXED BINARY(31);
  ON AREA BEGIN; PUT SKIP LIST('AREA condition', ONCODE); END;
  ALLOCATE REC IN(AR) SET(P);
  N = 5; NAME = 'first';
  O = P;
  ALLOCATE NODE IN(AR) SET(Q);
  V = 9;
  P = O;
  PUT SKIP LIST(N, NAME, V);
  FREE REC IN(AR);
  ALLOCATE REC IN(AR) SET(P);
  PUT SKIP LIST(N, NAME);
  AR = EMPTY;
  DO I = 1 TO 20;
    ALLOCATE NODE IN(AR) SET(Q);
    IF Q = NULL THEN LEAVE;
  END;
  PUT SKIP LIST('allocated', I);
END T32;
