T28: PROCEDURE OPTIONS(MAIN);
  DECLARE I FIXED BINARY(31), S FIXED BINARY(15), C CHAR(2);
  DECLARE B BIT(8), X FLOAT BINARY(53);
  I = 5; S = -2; C = 'AB';
  PUT SKIP LIST(UNSPEC(I));
  PUT SKIP LIST(UNSPEC(S));
  PUT SKIP LIST(UNSPEC(C));
  UNSPEC(I) = '00000000000000000000000100000001'B;
  PUT SKIP LIST(I);
  UNSPEC(S) = '1111111111111111'B;
  PUT SKIP LIST(S);
  UNSPEC(C) = '0100001001000011'B;
  PUT SKIP LIST(C);
  X = 1.0;
  PUT SKIP LIST(SUBSTR(UNSPEC(X), 1, 12));
  UNSPEC(X) = UNSPEC(X);
  PUT SKIP LIST(X);
END T28;
