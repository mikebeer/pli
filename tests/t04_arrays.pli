/* arrays: bounds, multi-dimensional, initial values, built-ins */
ARR: PROCEDURE OPTIONS(MAIN);
  DECLARE A(5) FIXED BINARY(31) INITIAL(5, 3, 9, 1, 7);
  DECLARE M(2, 3) FIXED BINARY(31);
  DECLARE B(-2:2) FIXED DECIMAL(5, 1);
  DECLARE NAMES(3) CHAR(8) INITIAL('ann', 'bob', 'carl');
  DECLARE Z(4) FIXED BINARY(31) INITIAL((4) 7);
  DECLARE (I, J, T, SWAPPED) FIXED BINARY(31);
  PUT SKIP LIST('sum =', SUM(A), 'dim =', DIM(A, 1));
  /* bubble sort */
  DO WHILE (SWAPPED ^= 0 | I = 0);
    I = 1;
    SWAPPED = 0;
    DO J = 1 TO 4;
      IF A(J) > A(J + 1) THEN DO;
        T = A(J); A(J) = A(J + 1); A(J + 1) = T;
        SWAPPED = 1;
      END;
    END;
  END;
  PUT SKIP LIST(A(1), A(2), A(3), A(4), A(5));
  DO I = 1 TO 2;
    DO J = 1 TO 3;
      M(I, J) = I * 10 + J;
    END;
  END;
  PUT SKIP LIST(M(1, 1), M(1, 3), M(2, 2), M(2, 3));
  DO I = LBOUND(B, 1) TO HBOUND(B, 1);
    B(I) = I * 1.5;
  END;
  PUT SKIP LIST(B(-2), B(0), B(2), LBOUND(B, 1), HBOUND(B, 1));
  PUT SKIP LIST(NAMES(1), NAMES(3));
  PUT SKIP LIST(Z);
  Z = 0;
  PUT SKIP LIST(Z(1), Z(4));
  PUT SKIP LIST(A);
END ARR;
