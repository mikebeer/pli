T21: PROCEDURE OPTIONS(MAIN);
  DECLARE EMP FILE RECORD KEYED UPDATE;
  DECLARE REC CHAR(20), K CHAR(5), KK CHAR(5);
  DECLARE LOG FILE RECORD SEQUENTIAL OUTPUT;
  DECLARE A(3) FIXED BINARY(31), B(3) FIXED BINARY(31);
  DECLARE SQ FILE RECORD INPUT;

  SHOWALL: PROCEDURE(F);
    DECLARE F FILE;
    DECLARE R CHAR(20), KY CHAR(5);
    ON ENDFILE(F) GOTO DONE;
    DO WHILE ('1'B);
      READ FILE(F) INTO(R) KEYTO(KY);
      PUT SKIP LIST(KY, R);
    END;
    DONE: ;
  END SHOWALL;

  OPEN FILE(EMP) TITLE('emp.dat') OUTPUT KEYED;
  WRITE FILE(EMP) FROM('Smith, J') KEYFROM('E0300');
  WRITE FILE(EMP) FROM('Adams, B') KEYFROM('E0100');
  WRITE FILE(EMP) FROM('Jones, K') KEYFROM('E0200');
  ON KEY(EMP) BEGIN; PUT SKIP LIST('KEY condition', ONCODE); END;
  WRITE FILE(EMP) FROM('Dup') KEYFROM('E0100');
  CLOSE FILE(EMP);

  OPEN FILE(EMP) TITLE('emp.dat') UPDATE KEYED;
  READ FILE(EMP) INTO(REC) KEY('E0200');
  PUT SKIP LIST('E0200 =', REC);
  REWRITE FILE(EMP) FROM('Jones, Karen');
  DELETE FILE(EMP) KEY('E0300');
  READ FILE(EMP) INTO(REC) KEY('E9999');
  CLOSE FILE(EMP);

  OPEN FILE(EMP) TITLE('emp.dat') INPUT KEYED;
  CALL SHOWALL(EMP);
  CLOSE FILE(EMP);

  A(1)=7; A(2)=8; A(3)=9;
  OPEN FILE(LOG) TITLE('arr.dat') OUTPUT;
  WRITE FILE(LOG) FROM(A);
  CLOSE FILE(LOG);
  OPEN FILE(SQ) TITLE('arr.dat') INPUT;
  READ FILE(SQ) INTO(B);
  PUT SKIP LIST(B(1), B(2), B(3));
  CLOSE FILE(SQ);
END T21;
