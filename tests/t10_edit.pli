/* edit-directed output */
EDIT: PROCEDURE OPTIONS(MAIN);
  DECLARE (A, B) FIXED DECIMAL(7, 2);
  DECLARE N FIXED BINARY(31);
  DECLARE W CHAR(8);
  DECLARE I FIXED BINARY(31);
  A = 1234.5; B = -7.25; N = 42; W = 'Total';
  PUT EDIT(W, A, B, N) (A(8), X(2), F(9, 2), F(8, 2), X(1), F(4));
  PUT SKIP EDIT('Name', 'Qty') (A(10), A(5));
  PUT SKIP EDIT('Widget', 12) (A(10), F(5));
  PUT SKIP EDIT(1, 2, 3) (F(3), SKIP, F(3), COLUMN(10), F(3));
  DO I = 1 TO 3;
    PUT SKIP EDIT(I, I * I, I ** 3) ((3) F(5));
  END;
  PUT SKIP EDIT(3.14159) (E(12, 4));
  PUT SKIP EDIT('x') (A);
  PUT SKIP EDIT('too long for field') (A(5));
  PUT SKIP EDIT(123456) (F(4));
  PUT SKIP EDIT(1.5, 2.5) (F(6, 1), F(6, 1));
END EDIT;
