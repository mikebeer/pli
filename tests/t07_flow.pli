/* control flow: SELECT, DO forms, LEAVE, ITERATE */
FLOW: PROCEDURE OPTIONS(MAIN);
  DECLARE (I, J, S) FIXED BINARY(31);
  DO I = 1 TO 10 BY 3;
    PUT SKIP LIST('by 3:', I);
  END;
  DO I = 5 TO 1 BY -2;
    PUT SKIP LIST('down:', I);
  END;
  I = 0;
  DO WHILE (I < 3);
    I = I + 1;
    PUT SKIP LIST('while', I);
  END;
  I = 10;
  DO UNTIL (I >= 10);
    PUT SKIP LIST('until body runs once', I);
    I = I + 1;
  END;
  S = 0;
  DO I = 1 TO 100;
    IF MOD(I, 2) = 0 THEN ITERATE;
    IF I > 9 THEN LEAVE;
    S = S + I;
  END;
  PUT SKIP LIST('sum of odd < 10 =', S);
  DO I = 1, 3, 5 TO 7;
    PUT SKIP LIST('list', I);
  END;
  OUTER: DO I = 1 TO 3;
    DO J = 1 TO 3;
      IF J = 2 THEN ITERATE OUTER;
      IF I = 3 THEN LEAVE OUTER;
      PUT SKIP LIST('ij', I, J);
    END;
  END OUTER;
  DO I = 1 TO 4;
    SELECT (I);
      WHEN (1) PUT SKIP LIST('one');
      WHEN (2, 3) PUT SKIP LIST('two or three');
      OTHERWISE PUT SKIP LIST('other');
    END;
  END;
  SELECT;
    WHEN (S > 100) PUT SKIP LIST('big');
    WHEN (S > 10) PUT SKIP LIST('medium');
    OTHERWISE PUT SKIP LIST('small');
  END;
END FLOW;
