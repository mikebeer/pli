/* PUT DATA, DISPLAY, GET EDIT of card images */
DT: PROCEDURE OPTIONS(MAIN);
  DECLARE A FIXED BINARY(31) INITIAL(3);
  DECLARE B FIXED BINARY(31) INITIAL(4);
  DECLARE C CHAR(5) INITIAL('xyz');
  DECLARE X FIXED DECIMAL(5, 2) INITIAL(9.5);
  DECLARE LINE CHAR(20);
  DECLARE (N1, N2) FIXED BINARY(31);
  PUT DATA(A, B, C, X);
  PUT SKIP;
  DISPLAY('operator message');
  GET EDIT(LINE) (A(20));
  PUT SKIP LIST('card:', LINE);
  GET SKIP EDIT(N1, N2) (F(3), X(1), F(3));
  PUT SKIP LIST(N1 + N2);
END DT;
