T29: PROCEDURE OPTIONS(MAIN);
  DECLARE A(6) FIXED BINARY(31);
  DECLARE B(3,2) FIXED BINARY(31) DEFINED A;
  DECLARE S CHAR(8), T CHAR(3) DEFINED S POSITION(6);
  DECLARE U CHAR(8) DEFINED(S);
  DECLARE (X, Y) FIXED BINARY(31);
  DECLARE Z FIXED BINARY(31) DEFINED X;
  DECLARE I FIXED BINARY(31);
  DO I = 1 TO 6; A(I) = I * 10; END;
  PUT SKIP LIST(B(1,1), B(2,2), B(3,2));
  B(2,1) = 99;
  PUT SKIP LIST(A(3));
  S = 'ABCDEFGH';
  PUT SKIP LIST(T);
  T = 'xyz';
  PUT SKIP LIST(S, U);
  X = 7;
  PUT SKIP LIST(Z);
  Z = 8;
  PUT SKIP LIST(X);
END T29;
