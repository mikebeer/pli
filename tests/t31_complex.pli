T31: PROCEDURE OPTIONS(MAIN);
  DECLARE (Z, W, V) COMPLEX FLOAT(15);
  DECLARE R FLOAT(15), A(2) COMPLEX FLOAT(15);
  CMAG: PROCEDURE(Q) RETURNS(FLOAT(15));
    DECLARE Q COMPLEX FLOAT(15);
    RETURN(ABS(Q));
  END CMAG;
  CSQ: PROCEDURE(Q) RETURNS(COMPLEX FLOAT(15));
    DECLARE Q COMPLEX FLOAT(15);
    RETURN(Q * Q);
  END CSQ;
  Z = 3 + 4I;
  W = 1 - 2I;
  PUT SKIP LIST(Z);
  PUT SKIP LIST(Z + W, Z - W);
  PUT SKIP LIST(Z * W);
  PUT SKIP LIST(Z / W);
  PUT SKIP LIST(ABS(Z), REAL(Z), IMAG(Z));
  PUT SKIP LIST(CONJG(Z), -Z);
  V = COMPLEX(1.5, -2.5);
  PUT SKIP LIST(V);
  R = 2;
  PUT SKIP LIST(Z * R, R + Z);
  PUT SKIP LIST(Z = 3 + 4I, Z = W, Z ^= W);
  PUT SKIP LIST(Z ** 2, SQRT(-4 + 0I), EXP(0I));
  PUT SKIP LIST(CMAG(Z), CSQ(Z));
  A(1) = 1I; A(2) = A(1) * A(1);
  PUT SKIP LIST(A(1), A(2));
  PUT SKIP EDIT(Z)(F(6,2), F(6,2));
  GET LIST(V);
  PUT SKIP LIST(V);
END T31;
