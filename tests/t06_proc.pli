/* procedures, functions, recursion, parameters */
MAIN: PROCEDURE OPTIONS(MAIN);
  DECLARE (X, Y) FIXED BINARY(31);
  DECLARE FACT ENTRY(FIXED BINARY(31)) RETURNS(FIXED BINARY(31));

  FACT: PROCEDURE(N) RETURNS(FIXED BINARY(31)) RECURSIVE;
    DECLARE N FIXED BINARY(31);
    IF N <= 1 THEN RETURN(1);
    RETURN(N * FACT(N - 1));
  END FACT;

  FIB: PROCEDURE(N) RETURNS(FIXED BINARY(31)) RECURSIVE;
    DECLARE N FIXED BINARY(31);
    IF N < 2 THEN RETURN(N);
    RETURN(FIB(N - 1) + FIB(N - 2));
  END FIB;

  SWAP: PROCEDURE(A, B);
    DECLARE (A, B) FIXED BINARY(31);
    DECLARE T FIXED BINARY(31);
    T = A; A = B; B = T;
  END SWAP;

  GREET: PROCEDURE(NAME) RETURNS(CHAR(40) VARYING);
    DECLARE NAME CHAR(*);
    RETURN('Hello, ' || NAME || '!');
  END GREET;

  PUT SKIP LIST('5! =', FACT(5), '10! =', FACT(10));
  PUT SKIP LIST('fib(15) =', FIB(15));
  X = 3; Y = 8;
  CALL SWAP(X, Y);
  PUT SKIP LIST('after swap:', X, Y);
  PUT SKIP LIST(GREET('PL/I'));
END MAIN;
