/* 64-bit integers */
w: procedure options(main);
dcl (a, b, c) fixed bin(63);
dcl d fixed bin(47);
dcl f fixed dec(18);
dcl i fixed bin(31);
dcl t(3) fixed bin(63);
dcl big fixed bin(63) init(9007199254740993);

a = 1;
do i = 1 to 20;
   a = a * i;
end;
put skip list ('20!', a);
a = 9223372036854775807;
put skip list ('max', a);
b = a - 1;
put skip list ('max-1', b, a - b);
put skip list ('big', big, big + 1);
if big + 1 > big then put skip list ('exact compare');
if big = 9007199254740993 then put skip list ('exact equal');
c = 4611686018427387904;
put skip list ('2**62', c, c / 2, mod(c + 3, 1000));
d = 140737488355327;
put skip list ('d', d, d * 2);
f = 123456789012345678;
put skip list ('f', f, f + 1);
t(1) = 1;
do i = 2 to 3;
   t(i) = t(i - 1) * 3000000000;
end;
put skip list ('t', t(1), t(2), t(3));
i = 7;
c = i * 1000000000000;
put skip list ('mixed', c, c / 7);
on fixedoverflow begin;
   put skip list ('overflow caught');
   goto done;
end;
a = 9223372036854775807;
a = a + 1;
put skip list ('not reached');
done: ;
end w;
