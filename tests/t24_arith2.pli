T24: PROCEDURE OPTIONS(MAIN);
  DECLARE (A, B) FIXED BINARY(31);
  DECLARE W FIXED BINARY(47), D FIXED DECIMAL(25,2);
  DECLARE S FIXED BINARY(15);
  DECLARE X FLOAT DECIMAL(15), Y FLOAT DECIMAL(15);

  ON FIXEDOVERFLOW BEGIN;
    PUT SKIP LIST('FIXEDOVERFLOW', ONCODE);
  END;
  ON OVERFLOW BEGIN;
    PUT SKIP LIST('OVERFLOW', ONCODE);
  END;
  ON UNDERFLOW BEGIN;
    PUT SKIP LIST('UNDERFLOW', ONCODE);
  END;

  A = 2000000000;
  B = A + A;
  PUT SKIP LIST('B =', B);

  W = 1099511627776;
  W = W * 4 + 3;
  PUT SKIP LIST('W =', W);

  D = 1234567890123.25;
  PUT SKIP LIST('D =', D);

  X = 1.0E300;
  Y = X * X;
  PUT SKIP LIST('Y big', Y > 1.0E307);
  X = 1.0E-300;
  Y = X * X;
  PUT SKIP LIST('Y =', Y);

  CALL SZ;
SZ: PROCEDURE;
  (SIZE): BEGIN;
    ON SIZE BEGIN;
      PUT SKIP LIST('SIZE', ONCODE);
    END;
    S = 40000;
  END;
END SZ;
END T24;
