T22: PROCEDURE OPTIONS(MAIN);
  DECLARE F FILE RECORD, G FILE RECORD UPDATE, R CHAR(20);
  DECLARE N FIXED BINARY(31);
  OPEN FILE(F) TITLE('u.txt') OUTPUT;
  WRITE FILE(F) FROM('alpha');
  WRITE FILE(F) FROM('beta');
  WRITE FILE(F) FROM('gamma');
  CLOSE FILE(F);
  OPEN FILE(G) TITLE('u.txt') UPDATE;
  READ FILE(G) INTO(R);
  READ FILE(G) INTO(R);
  REWRITE FILE(G) FROM('BETA CHANGED');
  READ FILE(G) INTO(R);
  CLOSE FILE(G);
  OPEN FILE(F) TITLE('u.txt') INPUT;
  ON ENDFILE(F) GOTO DONE;
  N = 0;
  DO WHILE ('1'B);
    READ FILE(F) INTO(R);
    N = N + 1;
    PUT SKIP LIST(N, R);
  END;
DONE:
  CLOSE FILE(F);
END T22;
