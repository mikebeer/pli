T30: PROCEDURE OPTIONS(MAIN);
  DECLARE A PICTURE 'ZZ,ZZ9.99', B PIC '999V99', C PIC '$$$,$$9.99';
  DECLARE D PIC '-ZZ9', E PIC 'ZZ9CR', F PIC '(4)9', G PIC '+99.9';
  DECLARE H PIC '99/99/99', K PIC 'AAA999';
  DECLARE X FIXED DECIMAL(9,2);
  A = 1234.5;      PUT SKIP LIST(A);
  A = 0.05;        PUT SKIP LIST(A);
  B = 12.345;      PUT SKIP LIST(B);
  X = B + 1;       PUT SKIP LIST(X);
  C = 1234567.891; PUT SKIP LIST(C);
  C = 5;           PUT SKIP LIST(C);
  C = 0;           PUT SKIP LIST(C);
  D = -7;          PUT SKIP LIST(D);
  D = 125;         PUT SKIP LIST(D);
  E = -3;          PUT SKIP LIST(E);
  E = 3;           PUT SKIP LIST(E);
  F = 42;          PUT SKIP LIST(F);
  G = -1.25;       PUT SKIP LIST(G);
  H = 310524;      PUT SKIP LIST(H);
  K = 'ABC';       PUT SKIP LIST(K);
  PUT SKIP LIST(A + 1, A = 0.05, 'Total: ' || C);
END T30;
