/* files: stream and record output, then read back */
FILES: PROCEDURE OPTIONS(MAIN);
  DECLARE OUT FILE OUTPUT STREAM PRINT;
  DECLARE INF FILE INPUT STREAM;
  DECLARE REC FILE RECORD;
  DECLARE LINE CHAR(40) VARYING;
  DECLARE BUF CHAR(20);
  DECLARE I FIXED BINARY(31);
  DECLARE EOF BIT(1) INITIAL('0'B);
  OPEN FILE(OUT) TITLE('plitest_out.txt') OUTPUT PRINT;
  DO I = 1 TO 3;
    PUT FILE(OUT) SKIP LIST('line', I);
  END;
  CLOSE FILE(OUT);
  OPEN FILE(REC) TITLE('plitest_rec.txt') OUTPUT RECORD;
  WRITE FILE(REC) FROM('first record');
  WRITE FILE(REC) FROM('second record');
  CLOSE FILE(REC);
  ON ENDFILE(REC) EOF = '1'B;
  OPEN FILE(REC) TITLE('plitest_rec.txt') INPUT RECORD;
  READ FILE(REC) INTO(BUF);
  DO WHILE (^EOF);
    PUT SKIP LIST('read:', BUF);
    READ FILE(REC) INTO(BUF);
  END;
  CLOSE FILE(REC);
  OPEN FILE(INF) TITLE('plitest_out.txt') INPUT;
  GET FILE(INF) LIST(LINE);
  PUT SKIP LIST('first word:', LINE);
  CLOSE FILE(INF);
END FILES;
